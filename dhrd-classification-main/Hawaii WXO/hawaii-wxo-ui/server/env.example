# Hawaii DHRD HRO — proxy environment variables
# Rename this file to .env and fill in the two required values,
# OR start the server with TKO_ENV_FILE pointing at the project credentials:
#
#   TKO_ENV_FILE=../../../.env uvicorn app.main:app --port 8081
#
# IMPORTANT: never commit real credentials. This file only shows the shape.

# ---- Required ---------------------------------------------------------------

# Watson Orchestrate instance URL (ca-tor instance for this project)
WO_INSTANCE=https://api.ca-tor.watson-orchestrate.cloud.ibm.com/instances/a9608575-ca60-44c3-951c-36c12a7b340a

# IBM Cloud API key (plain key — NOT a ZenApiKey)
# Copy the value of IBM_CLOUD_API_KEY from dhrd-classification-main/.env
WO_API_KEY=<your-ibm-cloud-api-key>

# ---- Optional ---------------------------------------------------------------

# CORS origin for the UI dev server (default: http://localhost:5174)
# Change this if you run the UI on a different port.
ALLOWED_ORIGIN=http://localhost:5174

# IAM token endpoint (default: https://iam.cloud.ibm.com/identity/token)
# IAM_TOKEN_URL=https://iam.cloud.ibm.com/identity/token

# Rate limits (requests per minute per browser identity)
# RATE_LIMIT_PER_MIN=120
# OPTIONS_RATE_LIMIT_PER_MIN=900

# IBM COS write-through for thread ownership (optional — local file only if unset)
# COS_API_KEY=
# COS_ENDPOINT=
# COS_BUCKET=
# COS_OBJECT=hawaii-wxo-ui/threads.json
